// Full-featured StackForge application
app Production {
    network edge {
        // Public-facing services
        proxy web using "nginx:1.25";
        static admin using "nginx:1.25";
        expose web on 80;
        web -> admin;
    }
    network core {
        // Application layer
        service gateway using "node:20";
        service auth using "node:20";
        // Data layer
        database primary using "postgres:16";
        cache session using "redis:7";
        gateway -> auth;
        gateway -> primary;
        gateway -> session;
        auth -> primary;
    }
    edge -> core;
}
