// Full-featured StackForge application
app Production {
    // Public-facing services
    frontend web using "nginx:1.25";
    frontend admin using "nginx:1.25";
    // API layer
    api gateway using "node:20";
    api auth using "node:20";
    // Data layer
    database primary using "postgres:16";
    cache session using "redis:7";
    // Expose public ports
    expose web on 80;
    expose admin on 8080;
    expose gateway on 3000;
    // Service connections
    web connects_to gateway;
    admin connects_to gateway;
    gateway connects_to auth;
    gateway connects_to primary;
    gateway connects_to session;
    auth connects_to primary;
}
